{
  "name": "shinona-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "node lint/check-source.js && eslint . --max-warnings 0",
    "lint:unused": "knip",
    "lint:structure": "eslint --config eslint.structure.config.js src && jscpd --no-colors",
    "test": "node --experimental-strip-types --test lint/*.test.js"
  },
  "dependencies": {
    "@arrow-js/core": "1.0.6",
    "@arrow-js/sandbox": "1.0.6",
    "@bufbuild/protobuf": "2.17.0",
    "@tanstack/vue-virtual": "3.13.54",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "@yusufceng1z/ding": "0.0.9",
    "markdown-it": "15.0.3",
    "pinia": "4.1.0",
    "remixicon": "4.9.1",
    "vue": "3.5.46",
    "vue-router": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jitl/quickjs-wasmfile-release-asyncify": "0.32.0",
    "@vitejs/plugin-vue": "6.0.11",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "jscpd": "5.4.3",
    "knip": "6.48.0",
    "less": "4.9.1",
    "postcss": "8.5.33",
    "postcss-less": "7.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14"
  }
}
