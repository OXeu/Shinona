{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["root", "elements"],
  "properties": {
    "root": { "$ref": "#/$defs/id" },
    "elements": {
      "type": "object", "minProperties": 1, "maxProperties": 40,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/element" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,48}$", "not": { "enum": ["__proto__", "prototype", "constructor"] } },
    "shortText": { "type": "string", "minLength": 1, "maxLength": 160 },
    "text": { "type": "string", "maxLength": 1200 },
    "children": { "type": "array", "maxItems": 40, "items": { "$ref": "#/$defs/id" } },
    "element": {
      "type": "object", "required": ["type", "props"], "additionalProperties": false,
      "properties": {
        "type": { "enum": ["Stack", "Card", "Text", "Metric", "Badge", "List", "Table", "Progress"] },
        "props": { "type": "object" },
        "children": { "$ref": "#/$defs/children" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "not": { "enum": ["Stack", "Card"] } } } },
          "then": { "properties": { "children": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "type": { "const": "Stack" } } },
          "then": { "properties": { "props": { "maxProperties": 0 } } }
        },
        {
          "if": { "properties": { "type": { "const": "Card" } } },
          "then": { "properties": { "props": { "additionalProperties": false, "required": ["title"], "properties": { "title": { "$ref": "#/$defs/shortText" }, "description": { "$ref": "#/$defs/text" } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "Text" } } },
          "then": { "properties": { "props": { "additionalProperties": false, "required": ["text"], "properties": { "text": { "$ref": "#/$defs/text" } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "Metric" } } },
          "then": { "properties": { "props": { "additionalProperties": false, "required": ["label", "value"], "properties": { "label": { "$ref": "#/$defs/shortText" }, "value": { "$ref": "#/$defs/shortText" }, "detail": { "$ref": "#/$defs/text" } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "Badge" } } },
          "then": { "properties": { "props": { "additionalProperties": false, "required": ["text"], "properties": { "text": { "$ref": "#/$defs/shortText" }, "tone": { "enum": ["neutral", "success", "warning", "danger"] } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "List" } } },
          "then": { "properties": { "props": { "additionalProperties": false, "required": ["items"], "properties": { "items": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/text" } } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "Table" } } },
          "then": { "properties": { "props": { "additionalProperties": false, "required": ["columns", "rows"], "properties": {
            "columns": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/shortText" } },
            "rows": { "type": "array", "maxItems": 24, "items": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/text" } } }
          } } } }
        },
        {
          "if": { "properties": { "type": { "const": "Progress" } } },
          "then": { "properties": { "props": { "additionalProperties": false, "required": ["label", "value"], "properties": { "label": { "$ref": "#/$defs/shortText" }, "value": { "type": "number", "minimum": 0, "maximum": 100 } } } } }
        }
      ]
    }
  }
}
