# Bootstrap values. Restart Shinona after changing them.
SHINONA_ADDR=127.0.0.1:8780
SHINONA_DATABASE=shinona.db
# SHINONA_SQLITE_READ_CONNECTIONS=8
# SHINONA_API_ORIGIN=http://127.0.0.1:8780
# SHINONA_WEB_ORIGIN=http://127.0.0.1:5173
# SHINONA_TRUSTED_PROXIES=127.0.0.1/32
# SHINONA_AGENT_WORKERS=4
# Transcript concurrency overrides. By default Shinona scales these limits by CPU count.
# SHINONA_TRANSCRIPT_EXPORT_CONCURRENCY=4
# SHINONA_TRANSCRIPT_PAGE_CONCURRENCY=32
# SHINONA_SQLITE_TRANSCRIPT_CACHE_MIB=32
# SHINONA_TRANSCRIPT_TURN_CACHE_MIB=32
# SHINONA_TRANSCRIPT_RESPONSE_CACHE_MIB=16
# SHINONA_SESSION_LIST_CACHE_MIB=16
# SHINONA_AUTH_PASSWORD_CONCURRENCY=2
# SHINONA_AUTH_RATE_LIMIT_ENTRIES=8192
# SHINONA_ARGON2_TIME=3
# SHINONA_ARGON2_MEMORY_KIB=65536
# SHINONA_ARGON2_THREADS=1

# Instance settings below are startup fallbacks for the web Settings page.

# Optional OpenID Connect login.
# SHINONA_OAUTH_ISSUER=
# SHINONA_OAUTH_CLIENT_ID=
# SHINONA_OAUTH_CLIENT_SECRET=
# SHINONA_RESEND_API_KEY=
# SHINONA_RESEND_FROM=Shinona <accounts@example.com>
# SHINONA_RESEND_API_URL=https://api.resend.com/emails
# SHINONA_RESEND_TIMEOUT_SECONDS=8

# Each account configures model and MCP endpoints in web Settings.
# Optional HTTPS origins explicitly trusted to reach private model servers.
# SHINONA_TRUSTED_MODEL_ORIGINS=https://models.example.com

# E2B Cloud or self-hosted configuration.
# E2B_API_KEY=
# SHINONA_E2B_TEMPLATE=base
# SHINONA_E2B_BASE_URL=http://127.0.0.1:3000
# SHINONA_E2B_PROXY_URL=http://127.0.0.1:3002
# SHINONA_E2B_DOMAIN=
# SHINONA_E2B_TIMEOUT=300
# SHINONA_E2B_ON_TIMEOUT=pause
# SHINONA_E2B_API_VERSION=auto
# SHINONA_E2B_WORKSPACE_USER=
# SHINONA_E2B_WORK_DIRECTORY=

# Users add their own Docker hosts under Settings → SSH servers.
# Optional exact SSH addresses on private networks that users may connect to.
# SHINONA_TRUSTED_SSH_ADDRESSES=workspace.lan:22

# SSH sandbox container policy for both shared and personal providers.
# SHINONA_SSH_CONTAINER_UID=65534
# SHINONA_SSH_CONTAINER_GID=65534
# SHINONA_SSH_CONTAINER_WORKDIR=/workspace
# SHINONA_SSH_CONTAINER_CPUS=2
# SHINONA_SSH_CONTAINER_MEMORY_MIB=4096
# SHINONA_SSH_CONTAINER_PIDS=512

# Optional shared SSH provider managed by the operator.
# SHINONA_SSH_ADDRESS=workspace.example.com:22
# SHINONA_SSH_USER=shinona
# SHINONA_SSH_KEY_PATH=/path/to/shinona_ed25519
# SHINONA_SSH_HOST_FINGERPRINT=SHA256:...
# SHINONA_SSH_TEMPLATE=buildpack-deps:bookworm-scm
