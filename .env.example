# Bootstrap values. Restart Shinona after changing them.
SHINONA_ADDR=127.0.0.1:8780
SHINONA_DATABASE=shinona.db
# SHINONA_API_ORIGIN=http://127.0.0.1:8780
# SHINONA_WEB_ORIGIN=http://127.0.0.1:5173

# Instance settings below are startup fallbacks for the web Settings page.

# Optional OpenID Connect login.
# SHINONA_OAUTH_ISSUER=
# SHINONA_OAUTH_CLIENT_ID=
# SHINONA_OAUTH_CLIENT_SECRET=
# SHINONA_RESEND_API_KEY=
# SHINONA_RESEND_FROM=Shinona <accounts@example.com>

# Each account configures model and MCP endpoints in web Settings.
# Optional HTTPS origins explicitly trusted to reach private model servers.
# SHINONA_TRUSTED_MODEL_ORIGINS=https://models.example.com

# E2B Cloud or self-hosted configuration.
# E2B_API_KEY=
# SHINONA_E2B_TEMPLATE=base
# SHINONA_E2B_BASE_URL=http://127.0.0.1:3000
# SHINONA_E2B_PROXY_URL=http://127.0.0.1:3002
# SHINONA_E2B_DOMAIN=
